# Copy this file to .env and fill it in. .env is git-ignored; never commit keys.

# Live transcription: https://console.deepgram.com -> API Keys -> Create a New API Key
DEEPGRAM_API_KEY=
# Transcription language (en, es, fr, de, hi, ... or "multi" for mixed languages)
DEEPGRAM_LANGUAGE=en

# AI notes: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Database. For local Supabase, run `npm run db:start` then `npm run db:env`
# and these two lines are filled in for you. Leave them empty to save
# meetings to a file on this computer instead.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
