# Copy this file to .env and fill it in. .env is git-ignored; never commit keys.
# Every key is optional: with none set, the app records and transcribes on
# your computer for free and saves meetings to the data/ folder.

# --- Transcription ---------------------------------------------------------
# Empty = free on-device transcription (OpenAI Whisper, runs on your PC, no account).
# Set it to use Deepgram instead: faster, word-by-word live, more accurate, paid.
# https://console.deepgram.com -> API Keys -> Create a New API Key
DEEPGRAM_API_KEY=
# Language: en, es, fr, de, hi, ... ("multi" for mixed languages with Deepgram)
TRANSCRIPTION_LANGUAGE=en
# Names and jargon Deepgram should spell right, comma-separated (Deepgram only)
DEEPGRAM_KEYTERMS=
# Bigger on-device model = better accuracy, slower (e.g. onnx-community/whisper-small.en)
LOCAL_WHISPER_MODEL=

# --- AI notes (either one) ----------------------------------------------------
# OpenRouter: https://openrouter.ai/settings/keys  (runs Claude for you)
OPENROUTER_API_KEY=
# Model to ask for (default anthropic/claude-opus-5.5). If your OpenRouter
# guardrails block it, the app falls back to openrouter/auto and tells you.
OPENROUTER_MODEL=
# Or Anthropic directly: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Database ------------------------------------------------------------------
# For local Supabase, run `npm run db:start` then `npm run db:env` and these
# are filled in for you. Empty = meetings are saved to data/meetings.json.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
